TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
TELEGRAM_SESSION_NAME=telegram_proxy
TELEGRAM_SESSION_DIR=./data/telegram

# Optional bootstrap path if you already have a Telethon string session.
TELEGRAM_SESSION_STRING=

APP_HOST=0.0.0.0
PORT=4040
LOG_LEVEL=INFO

DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100
DEFAULT_CONTEXT_SIZE=5
MAX_CONTEXT_SIZE=20
TELEGRAM_HISTORY_WAIT_TIME=1.0
TELEGRAM_HISTORY_CONCURRENCY=1
TELEGRAM_FLOOD_SLEEP_THRESHOLD=5
TELEGRAM_ALBUM_WINDOW=24

# Enable with a strong token on any non-local deployment.
API_AUTH_ENABLED=false
API_BEARER_TOKEN=

# Keep off until the owner approves the disclosed use under Telegram's terms.
TELEGRAM_BOT_MODE=off
TELEGRAM_BOT_TOKEN=
# Set a positive owner ID when enabling Bot mode; omit while off.
# TELEGRAM_BOT_OWNER_USER_ID=123456
TELEGRAM_BOT_STORE_KEY=
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org
TELEGRAM_BOT_REQUEST_TIMEOUT=10
TELEGRAM_BOT_POLL_TIMEOUT=30
TELEGRAM_BOT_STORE_PATH=./data/telegram/bot-cache.sqlite3
TELEGRAM_BOT_RETENTION_DAYS=30
